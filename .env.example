# Which port on THIS machine each Docker service answers on. Docker Compose reads this file
# automatically (it must be named .env and sit next to docker-compose.yml). Copy it to .env and
# change any number here if it clashes with something else already running, or if you'd rather use
# different ports - no need to edit docker-compose.yml itself.
#
# These are host-side ports only - the ports the services use *inside* their containers, and how the
# containers talk to each other, are unaffected and stay fixed.

BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
