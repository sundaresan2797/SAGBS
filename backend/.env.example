APP_NAME=Employee Management System
COMPANY_NAME=Sri Annamalai Global Business Service
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/employee_management
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/employee_management
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/employee_management_test

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Employee photos: largest picture accepted (MB), and the square size it is saved at (pixels)
PHOTO_MAX_UPLOAD_MB=5
PHOTO_SIZE_PX=400

CORS_ORIGINS=http://localhost:5173

TIMEZONE=Asia/Kolkata

# Attendance policy (times are in the TIMEZONE above)
WORKDAY_START_HOUR=9
WORKDAY_START_MINUTE=0
# Checking in up to this many minutes after the start is still on time
LATE_GRACE_MINUTES=10
# A full shift in minutes; anything beyond it is overtime
STANDARD_SHIFT_MINUTES=510
# Working less than this many minutes counts as a half day
FULL_DAY_MINIMUM_MINUTES=465
# A day longer than this many minutes is flagged "please check" (usually a late check-out)
LONG_DAY_FLAG_MINUTES=720
# Checking in after this time counts as a half day
HALF_DAY_CHECKIN_AFTER_HOUR=13
HALF_DAY_CHECKIN_AFTER_MINUTE=30

# The company's lunch break. Whatever part of it falls inside someone's check-in to check-out
# span is deducted from their working minutes automatically - nobody punches out for lunch.
LUNCH_START_HOUR=13
LUNCH_START_MINUTE=0
LUNCH_BREAK_MINUTES=30

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Permission (a few hours off): how many per person per calendar month, and the longest one in minutes
PERMISSION_MONTHLY_LIMIT=2
PERMISSION_MAX_MINUTES=120
