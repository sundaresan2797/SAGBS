VITE_API_BASE_URL=/api/v1
VITE_COMPANY_NAME=SAT Group
VITE_POWERED_BY=Spironova AI

# Where the backend runs, as seen from this dev server (the browser never uses it).
# Same machine: http://127.0.0.1:8000. In Docker Compose it is set to http://backend:8000.
BACKEND_URL=http://127.0.0.1:8000

# Optional: extra names this server may be opened by, comma separated (e.g. ems.mycompany.com).
ALLOWED_HOSTS=.ngrok-free.app,.ngrok-free.dev,.ngrok.app,.ngrok.io
